{
  "name": "moli-cultivation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "play": "tsx tools/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/client/main.ts",
    "dev:activity": "tsx tools/activity.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "balance": "tsx tools/balance.ts",
    "balance:dwelling": "tsx tools/balance-dwelling.ts",
    "balance:crafting": "tsx tools/balance-crafting.ts",
    "balance:equipment": "tsx tools/balance-equipment.ts",
    "balance:growth": "tsx tools/balance-growth.ts",
    "balance:monsters": "tsx tools/balance-growth.ts --monsters",
    "balance:investment": "tsx tools/balance-investment.ts",
    "balance:economy": "tsx tools/balance-economy.ts",
    "balance:combat": "tsx tools/balance-combat.ts",
    "db:up": "tsx tools/database.ts up",
    "db:down": "tsx tools/database.ts down",
    "db:migrate": "tsx server/client/migrate.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}

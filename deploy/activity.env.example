# VPS testing only. Keep the real file outside the checkout, for example /etc/moli-activity.env.
ACTIVITY_DOMAIN=game.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Generate two DIFFERENT random hexadecimal passwords, for example: openssl rand -hex 32
ACTIVITY_DATABASE_ADMIN_PASSWORD=
ACTIVITY_DATABASE_PASSWORD=

# Loopback-only host port for an existing reverse proxy; the container always uses 5180.
ACTIVITY_BIND_PORT=5180

# Optional comma-separated VERIFIED Discord user IDs allowed to delete messages and mute players.
# Never accept administrator status from a browser.
SOCIAL_MODERATOR_IDS=
